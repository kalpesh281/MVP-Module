# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# EVERY VALUE BELOW IS OPTIONAL. With a completely empty .env the scanner
# still runs and still produces a grade — it just uses static copy instead
# of AI-written copy, and keeps the result in memory instead of MongoDB.
# That is a hard requirement, not a degraded mode. docs/testing.md GATE 1.4

# --- AI provider ---------------------------------------------------------
# Set ONE. The adapter auto-detects, in this order:
#   ANTHROPIC_API_KEY -> OPENAI_API_KEY -> GROQ_API_KEY -> OPENROUTER_API_KEY
#
# Free option:  GROQ_API_KEY from console.groq.com — no card, 30 req/min,
#               1,000 req/day, 200K tokens/day. The token cap binds first;
#               it is roughly 60-80 scans/day. Fine for a prototype.
# Paid option:  OPENAI_API_KEY with a mini model is a few paise per scan.
#
OPENAI_API_KEY=
GROQ_API_KEY=
# ANTHROPIC_API_KEY=            # not required — leave unset if you have no key
# OPENROUTER_API_KEY=           # 20 req/min, 50/day on :free models

# Per-call model override. NOT keys — leave blank and auto-detect handles it.
# Only set these to force a specific provider for a specific call.
#   values: claude | gpt | groq | openrouter
# PROVIDER_CLASSIFY=groq        # cheap call: structured extraction from a webpage
# PROVIDER_REPORT=gpt           # the product's voice — do not put this on a free tier
# PROVIDER_QA=groq

# --- Optional data sources ----------------------------------------------
# WITHOUT A KEY the scanner uses HIBP's free, keyless breaches endpoint,
# which tells us whether the COMPANY ITSELF has a disclosed breach on
# record. That is prior-incident history — a real proposal-form question —
# and it is worth 8 of the 20 points in this category.
#
# WITH A KEY (~USD 4/month at haveibeenpwned.com/API/Key) we can also count
# how many of their staff addresses appear in breach corpora, which unlocks
# the remaining 12 points.
#
# Leave blank for the prototype. docs/scan-checks.md section 2
HIBP_API_KEY=

# --- Database ------------------------------------------------------------
# Leave blank to run without persistence (no caching, no analytics, no
# shareable result URLs — everything else works).
#
# THIS IS A CREDENTIAL. .env is gitignored and it is never committed,
# logged, or returned in an error response. Percent-encode special
# characters in the password. In Atlas: allowlist specific IPs, not
# 0.0.0.0/0, and grant the app user readWrite on `scorecard` only.
#
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=scorecard

# --- App -----------------------------------------------------------------
# A domain rescanned inside this window returns the cached result, labelled
# with its age. Never present a cached result as live.
SCAN_CACHE_HOURS=6

# Sent on every outbound request. Must be truthful and carry a contact URL:
# we perform passive reconnaissance against domains we do not own, and being
# identifiable is part of why that is defensible. docs/scan-checks.md
USER_AGENT=Boundry/0.1 (+https://github.com/kalpesh281)

# --- certificate transparency (optional but strongly recommended) --------
# Free key, no card: https://sslmate.com/signup?for=certspotter_api
# With a key: 100 requests/hour, over a smaller burst bucket that drains
# in a few rapid calls and refills on its own. One scan costs one request
# for most domains, two for very large ones.
# Without a key the quota runs out after a few scans and the
# 23-point attack-surface check starts returning 429, which suppresses the
# grade entirely.
CERTSPOTTER_API_KEY=

# Scans per IP per hour. Leave unset in production — 10 is the shipped
# default. Raise it locally when your own testing keeps tripping it.
# RATE_LIMIT_PER_IP=100
