# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Minimum to run a scan: nothing at all.
# Minimum to run a scan WITH AI copy: one provider key.
# Minimum to persist scans: MONGODB_URI.

# --- AI provider ---------------------------------------------------------
# Set at least one. The adapter auto-selects whichever is present, in this
# order: anthropic -> openai -> groq -> openrouter.
#
# With none of these set the scan still returns a valid grade, premium and
# fix list using static fallback copy. That is a hard requirement, not a
# degraded mode. See docs/testing.md GATE 1 section 1.4.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Per-call provider override: claude | gpt | groq | openrouter
# Leave unset to auto-detect from the keys above.
# PROVIDER_REPORT is the product's voice — do not downgrade it to a free tier.
PROVIDER_CLASSIFY=
PROVIDER_REPORT=
PROVIDER_QA=

# --- Optional data sources ----------------------------------------------
# Without this the breached-credentials check returns "inconclusive" and its
# 20 points are removed from the denominator — the company is NOT graded well
# because the check could not run. See docs/scoring-and-pricing.md section 3.
# ~USD 4/month at haveibeenpwned.com/API/Key
HIBP_API_KEY=

# --- Database ------------------------------------------------------------
# THIS IS A CREDENTIAL. It lives here, .env is gitignored, and it is never
# committed, logged, or returned in an error response.
# Percent-encode any special characters in the password.
# In Atlas: allowlist specific IPs, not 0.0.0.0/0. Grant the app user
# readWrite on the `scorecard` database only.
#
# mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=scorecard

# --- App -----------------------------------------------------------------
# A domain rescanned inside this window returns the cached result, labelled
# with its age. Never present a cached result as live.
SCAN_CACHE_HOURS=6

# Sent on every outbound request. Must be truthful and carry a contact URL:
# we perform passive reconnaissance against domains we do not own, and being
# identifiable is part of why that is defensible. See docs/scan-checks.md.
USER_AGENT=CyberScorecard/0.1 (+https://example.com/about-our-scanner)
