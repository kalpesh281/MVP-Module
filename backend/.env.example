# --- AI provider ---------------------------------------------------------
# Set at least one. The adapter auto-selects whichever is present.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Per-call provider override: claude | gpt | groq | openrouter
# Leave unset to auto-detect from the keys above.
PROVIDER_CLASSIFY=
PROVIDER_REPORT=
PROVIDER_QA=

# --- Optional data sources ----------------------------------------------
# Without this, the breached-credentials check returns "inconclusive"
# and its points are excluded from scoring (see docs/scoring-and-pricing.md).
HIBP_API_KEY=

# --- Database ------------------------------------------------------------
MONGODB_URI=
MONGODB_DB=scorecard

# --- App -----------------------------------------------------------------
SCAN_CACHE_HOURS=6
USER_AGENT=CyberScorecard/0.1 (+https://example.com/about-our-scanner)
